# ==============================================================================
# SistemaVisionTech (WebWave) - Plantilla de Variables de Entorno Segura
# COPIA este archivo como .env y define los valores reales en tus paneles de hosting.
# NUNCA subas archivos .env ni cadenas reales al repositorio Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL en Supabase)
# ------------------------------------------------------------------------------
# Cadena de conexión JDBC o Npgsql directa al Transaction Pooler (puerto 6543 o 5432)
DATABASE_URL=Host=aws-1-ca-central-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.[TU_PROYECTO_REF];Password=[TU_PASSWORD_AQUI];SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Minimum Pool Size=2;Maximum Pool Size=20;Connection Idle Lifetime=300;Keepalive=30;

# Opcional: Nombre alternativo si se usa SupabaseConnection
SupabaseConnection=Host=aws-1-ca-central-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.[TU_PROYECTO_REF];Password=[TU_PASSWORD_AQUI];SSL Mode=Require;Trust Server Certificate=true;Pooling=true;

# ------------------------------------------------------------------------------
# 2. Autenticación y Tokens JWT
# ------------------------------------------------------------------------------
# Clave simétrica de al menos 32 caracteres criptográficamente aleatorios
JWT_KEY=GeneraUnaClaveAleatoriaDeAlMenos32Caracteres!2026#
JWT_ISSUER=SistemaVisionTech.API
JWT_AUDIENCE=SistemaVisionTech.Client
JWT_EXPIRES_IN_MINUTES=120

# ------------------------------------------------------------------------------
# 3. Políticas de Red y CORS
# ------------------------------------------------------------------------------
# Dominios permitidos separados por comas (sin comillas)
CORS_ALLOWED_ORIGINS=https://webwave-sigma.vercel.app,http://localhost:4200

# ------------------------------------------------------------------------------
# 4. Entorno de Ejecución
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
